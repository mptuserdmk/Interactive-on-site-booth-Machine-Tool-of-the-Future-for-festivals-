# AI-Фотолокация «Станок Будущего»
# Конфигурация для быстрого запуска на мероприятии

# AI Провайдер:
# - bothub: BotHub API (работает в РФ, оплата картами РФ / безнал, без VPN)
# - mock: офлайн генерация/заглушки для локальных тестов
# - fal: Fal.ai Flux/SDXL
# - replicate: Replicate FaceID
# Ключ оставлен ПУСТЫМ намеренно: раньше здесь стоял плейсхолдер, который health считал рабочим ключом,
# а все генерации молча уходили в mock. Пока ключа нет, панель оператора показывает «КЛЮЧ НЕ НАСТРОЕН».
AI_PROVIDER=bothub
AI_API_KEY=
BOTHUB_MODEL=gemini-2.5-flash-image
BOTHUB_API_BASE=https://openai.bothub.chat/v1
# Проверка SSL (true = проверка с доверием к сертификатам Минцифры РФ; false = отключить при SSL WRONG на фестивальном Wi-Fi/прокси)
AI_SSL_VERIFY=true

# Доступ к стенду с других устройств (ноутбук оператора, планшет-киоск).
# Задайте длинный случайный код (например, результат: python -c "import secrets;print(secrets.token_urlsafe(12))").
# Пусто → новый код при каждом запуске (печатается в консоли). Сам ПК стенда (localhost) доступен без кода.
ACCESS_TOKEN=
# Документация API (/docs) в проде выключена
ENABLE_API_DOCS=false

# Адрес, который печатается в QR на карточках. Пусто → http://<IP этого ПК>:<PORT>.
# Если у площадки есть домен/HTTPS-прокси — укажите его здесь.
BASE_URL=
PORT=8000

# Настройки камеры
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_MIRROR=true
# false: если USB-камера не отвечает, стенд просит снять телефоном, а не печатает заглушку вместо ребёнка
CAMERA_MOCK_FALLBACK=false
MAX_UPLOAD_MB=15

# Настройки фотопринтера
# Имя принтера точно как в «Принтеры и сканеры» Windows. Пусто → принтер по умолчанию (проверьте, что это фотопринтер!)
PRINTER_NAME=
ENABLE_AUTO_PRINT=true
PRINT_SIMULATION_MODE=false
REPRINT_COOLDOWN_SECONDS=10

# Политика приватности: исходное фото и AI-портрет удаляются сразу после сборки карточки
# (и при ошибке/брошенной сессии). Карточки удаляет scripts\cleanup_storage.py в конце дня.
DELETE_SOURCE_PHOTOS_AFTER_PRINT=true

# Брендинг фестиваля
FESTIVAL_NAME=ОСЕННИЙ ПРОМЫШЛЕННЫЙ ФЕСТИВАЛЬ КОЛЛЕДЖЕЙ МОСКВЫ
FESTIVAL_HASHTAG=#ФЕСТИВАЛЬ2026
 
# Платформа ботов для выдачи карточек (max, telegram, both)
BOT_PLATFORM=max

# Бот в мессенджере МАКС (dev.max.ru)
# Токен бота из личного кабинета MAX для бизнеса / MasterBot
MAX_BOT_TOKEN=f9LHodD0cOK9gh0LpbobsATbC8NpmzvHSboGyfitLuLfeDllxaeYto6vuTZWKDp-caZjx6mOhNayV0c3SpJr
# Username бота в MAX без @ (например: StanokFutureBot)
MAX_BOT_USERNAME=se14711058_bot
# Базовый адрес API MAX (по умолчанию https://platform-api2.max.ru)
MAX_API_BASE=https://platform-api2.max.ru

# Telegram-бот для выдачи карточек (опционально, если BOT_PLATFORM=telegram или both)
# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
# Username бота без @ (например: StanokFutureBot). Если не указан — определится автоматически по токену
TELEGRAM_BOT_USERNAME=
# Прокси для Telegram-бота (если api.telegram.org блокируется или недоступен)
# Поддерживаются: http://, https://, socks5://
# Примеры:
# TELEGRAM_PROXY_URL=http://user:password@1.2.3.4:8080
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=
# Задержка появления QR-кода на экране киоска в миллисекундах (по умолчанию 1500 мс)
QR_REVEAL_DELAY_MS=1500
