# AI-Фотолокация «Станок Будущего»
# Конфигурация для быстрого запуска на мероприятии

# AI Провайдер: mock (офлайн/бесплатно для тестов), fal (Fal.ai Flux/SDXL), replicate (Replicate FaceID)
AI_PROVIDER=mock
AI_API_KEY=

# Настройки камеры
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_MIRROR=true

# Настройки фотопринтера
# Оставьте пустым для использования принтера по умолчанию в Windows
PRINTER_NAME=
ENABLE_AUTO_PRINT=true
PRINT_SIMULATION_MODE=false

# Политика приватности (удаление исходных фото детей после печати)
DELETE_SOURCE_PHOTOS_AFTER_PRINT=true

# Брендинг фестиваля
FESTIVAL_NAME=FUTURE INDUSTRY 2026
FESTIVAL_HASHTAG=#ФЕСТИВАЛЬ2026
