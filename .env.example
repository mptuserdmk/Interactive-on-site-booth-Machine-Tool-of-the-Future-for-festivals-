# AI-Фотолокация «Станок Будущего»
# Конфигурация для быстрого запуска на мероприятии

# AI Провайдер:
# - bothub: BotHub API (работает в РФ, оплата картами РФ / безнал, без VPN)
# - mock: офлайн генерация/заглушки для локальных тестов
# - fal: Fal.ai Flux/SDXL
# - replicate: Replicate FaceID
# Ключ оставлен ПУСТЫМ намеренно: раньше здесь стоял плейсхолдер, который health считал рабочим ключом,
# а все генерации молча уходили в mock. Пока ключа нет, панель оператора показывает «КЛЮЧ НЕ НАСТРОЕН».
AI_PROVIDER=bothub
AI_API_KEY=
BOTHUB_MODEL=gemini-2.5-flash-image

# Доступ к стенду с других устройств (ноутбук оператора, планшет-киоск).
# Задайте длинный случайный код (например, результат: python -c "import secrets;print(secrets.token_urlsafe(12))").
# Пусто → новый код при каждом запуске (печатается в консоли). Сам ПК стенда (localhost) доступен без кода.
ACCESS_TOKEN=
# Документация API (/docs) в проде выключена
ENABLE_API_DOCS=false

# Адрес, который печатается в QR на карточках. Пусто → http://<IP этого ПК>:<PORT>.
# Если у площадки есть домен/HTTPS-прокси — укажите его здесь.
BASE_URL=
PORT=8000

# Настройки камеры
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_MIRROR=true
# false: если USB-камера не отвечает, стенд просит снять телефоном, а не печатает заглушку вместо ребёнка
CAMERA_MOCK_FALLBACK=false
MAX_UPLOAD_MB=15

# Настройки фотопринтера
# Имя принтера точно как в «Принтеры и сканеры» Windows. Пусто → принтер по умолчанию (проверьте, что это фотопринтер!)
PRINTER_NAME=
ENABLE_AUTO_PRINT=true
PRINT_SIMULATION_MODE=false
REPRINT_COOLDOWN_SECONDS=10

# Политика приватности: исходное фото и AI-портрет удаляются сразу после сборки карточки
# (и при ошибке/брошенной сессии). Карточки удаляет scripts\cleanup_storage.py в конце дня.
DELETE_SOURCE_PHOTOS_AFTER_PRINT=true

# Брендинг фестиваля
FESTIVAL_NAME=FUTURE INDUSTRY 2026
FESTIVAL_HASHTAG=#ФЕСТИВАЛЬ2026
