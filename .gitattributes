# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Shell scripts must always have LF line endings for Linux execution
*.sh text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf

# Source code and web assets in UTF-8
*.py text eol=lf diff=python
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.env.example text eol=lf

# Binary files
*.ttf binary
*.otf binary
*.onnx binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ico binary
*.db binary

# Вендоренные библиотеки хранятся байт-в-байт: SHA256SUMS должен совпадать после checkout на Windows
frontend/static/vendor/** -text
