# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env

# SQLite Databases & temporary event data
data/*.db
data/*.sqlite
data/*.sqlite3

# Participant Storage (Photos, Cards, AI Outputs)
storage/photos/*
storage/generated/*
storage/cards/*
!storage/photos/.gitkeep
!storage/generated/.gitkeep
!storage/cards/.gitkeep

# Large font binaries (installed on Linux via fonts-dejavu-core)
assets/fonts/*.ttf
assets/fonts/*.otf
!assets/fonts/.gitkeep

